# StudyBuddy Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI (Member B provides cluster credentials)
# Leave blank to use integrated local in-memory fallback for local development
MONGODB_URI=mongodb://localhost:27017/studybuddy

# JWT Authentication Secret
JWT_SECRET=studybuddy_jwt_secret_dev_key_2026

# LLM API Configuration (Member A / Lead)
# Can be a Google Gemini API Key.
# If left empty, StudyBuddy runs in offline smart study tutor simulator mode.
GEMINI_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_TIMEOUT_MS=15000

# Client URL for CORS
CLIENT_URL=http://localhost:5173
